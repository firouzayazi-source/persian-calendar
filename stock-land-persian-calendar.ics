BEGIN:VEVENT
SUMMARY:چهارشنبه
DTSTART;VALUE=DATE:20281018
DTEND;VALUE=DATE:20281019
DTSTAMP:20261019T153735Z
UID:stockland-jalali-info-20281018@stock-land
DESCRIPTION:چهارشنبه ۲۷ مهر ۱۴۰۷\n۱۸ اکتبر ۲۰۲
 ۸\n\nمناسبت‌های این روز:\n• درگذشت توماس ا
 دیسون\n• پرتاب فضاپیمای گالیله به فضا\n• 
 زادروز ابراهیم گلستان کارگردان، نخستین 
 برندهٔ یک جایزه بین‌المللی برای سینمای 
 ایران\n• زادروز آنری برگسونفیلسوف وادیب 
 مشهور فرانسوی، برندهٔ جایزه نوبل ادبیات 
 سال۱۹۲۷\n• درگذشت سانتیاگو رامون کاخال‏
  زیست‌شناس و پزشک اسپانیایی، برندهٔ جای
 زه نوبل فیزیولوژی و پزشکی سال ۱۹۰۶\n\n🐟 ۱
 ۵۳ روز تا نوروز\nتقویم فارسی استوک لند
TRANSP:TRANSPARENT
END:VEVENT
